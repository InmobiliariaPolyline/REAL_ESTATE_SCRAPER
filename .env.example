# Copia este archivo a `.env` (desarrollo local) o crea estas variables en Netlify → Site configuration →
# Environment variables. Guía completa: README.md y docs/ENTREGA.md. Nunca subas valores reales al repositorio.

# ── Base de datos (obligatorio, SOLO servidor) ──────────────────────────────
# Cadena de conexión de Neon (Dashboard → Connection details). Nunca la subas al repositorio
# ni la pongas en variables VITE_* (se expondrían en el navegador).
DATABASE_URL=postgresql://USUARIO:CLAVE@HOST.neon.tech/neondb?sslmode=require

# ── Vista central para el agente de Coze (opcional) ──────────────────────────
# Cadena de conexión del rol `writer_scraper` de la base central. Solo servidor. Sin ella, no se sincroniza.
# CENTRAL_DATABASE_URL=…

# ── API: opcional ────────────────────────────────────────────────────────────
# Tipo de cambio PEN por 1 USD (usar el mismo valor que VITE_USD_TO_PEN_RATE).
USD_TO_PEN_RATE=3.75
# Alertas del vigilante (watchdog) y umbral en horas sin actividad (webhook compatible con Slack/Discord).
# ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...
# ALERT_STALE_HOURS=24
# Para un planificador externo: POST /api/internal/watchdog con la cabecera x-cron-secret.
# CRON_SECRET=

# ── Cliente (visibles en el navegador) ───────────────────────────────────────
VITE_ADMIN_WHATSAPP=51943812536
VITE_USD_TO_PEN_RATE=3.75
# Solo si la API está en otro dominio (por defecto: mismo origen, /api).
# VITE_API_URL=https://api.midominio.com

# ── Servidor Express (opcional, si no usas Netlify) ──────────────────────────
# PORT=3000
# CSP_EXTRA_CONNECT_SRC=https://api.midominio.com

# ── Scraper propio de InfoCasas (docs/SCRAPER_PROPIO.md) ─────────────────────
# Clave de 24 caracteres o más. El MISMO valor va como secreto INGESTA_TOKEN en GitHub (Settings → Secrets).
# Sin ella, POST /api/ingesta responde 501 y no recibe nada.
# INGESTA_TOKEN=
# Botón «Ejecutar scraper propio» del panel: token fino de GitHub (solo este repositorio, permiso
# Actions: Read and write; tiene vencimiento) y «usuario/repositorio».
# GITHUB_TOKEN=
# GITHUB_REPO=InmobiliariaPolyline/REAL_ESTATE_SCRAPER

# ── Copia de portadas a Cloudinary (docs/FOTOS_CLOUDINARY.md) ────────────────
# Sin esta variable no se copia nada.
# CLOUDINARY_URL=cloudinary://CLAVE:SECRETO@NOMBRE

# ── Carga automática con Apify (docs/CARGA_APIFY.md) ─────────────────────────
# Sin las dos primeras variables no se ejecuta nada.
# APIFY_TOKEN=
# APIFY_WEBHOOK_SECRET=
# Opcionales: otro actor por fuente («usuario~nombre»; APIFY_ACTOR_RESPALDO=ninguno lo desactiva) y sus búsquedas a rotar.
# APIFY_ACTOR=
# APIFY_ACTOR_URBANIA=
# APIFY_ACTOR_INFOCASAS=
# APIFY_ACTOR_PROPERATI=
# APIFY_ACTOR_RESPALDO=
# CARGA_URLS=
# CARGA_URLS_URBANIA=
# CARGA_URLS_INFOCASAS=
# CARGA_URLS_PROPERATI=
# Crédito mensual de Apify en US$ (5 en el plan gratuito) y costo por 1 000 avisos del actor (3).
# APIFY_CREDIT_USD=5
# APIFY_COST_PER_1000=3
