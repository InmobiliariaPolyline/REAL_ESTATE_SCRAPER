# ── Supabase (obligatorio) ───────────────────────────────────────────────────
# Project Settings → API en el panel de Supabase.
VITE_SUPABASE_URL=https://TU_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=TU_ANON_KEY

# ── Opcional ─────────────────────────────────────────────────────────────────
# WhatsApp del administrador (solo dígitos, con código de país).
VITE_ADMIN_WHATSAPP=51943812536
# Tipo de cambio PEN por 1 USD usado para comparar y mostrar precios.
VITE_USD_TO_PEN_RATE=3.75

# ── Servidor Express (producción) ────────────────────────────────────────────
# PORT=3000
# Orígenes extra permitidos en connect-src de la CSP (p. ej. dominio propio de Supabase), separados por comas.
# CSP_EXTRA_CONNECT_SRC=https://api.midominio.com
